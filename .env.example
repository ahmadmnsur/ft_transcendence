ADMIN_PASSWORD=
FT_OAUTH_CLIENT_ID=
FT_OAUTH_CLIENT_SECRET=
MODERATOR_EMAIL=
MODERATOR_PASSWORD=
SEED_STUDENT_PASSWORD=
# Local API keys expire 2041-10-04; image-specific names repeat the signing material.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY=
SERVICE_ROLE_KEY=
GOTRUE_JWT_KEYS=
JWT_JWKS=
GOTRUE_JWT_SECRET=
AUTH_JWT_SECRET=
SERVICE_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
LOCAL_DATABASE_URL=
LOCAL_PUBLIC_ORIGIN=
LOCAL_BIND_ADDRESS=
LOCAL_ADMIN_PASSWORD=
