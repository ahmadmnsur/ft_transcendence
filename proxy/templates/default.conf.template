server {
    listen 8080;
    return 301 ${PUBLIC_ORIGIN}$request_uri;
}

server {
    listen 8443 ssl;
    http2 on;

    ssl_certificate /etc/nginx/peerconnect.crt;
    ssl_certificate_key /etc/nginx/peerconnect.key;

    include /etc/nginx/snippets/api.conf;

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src 'self'; object-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;
    }
}
