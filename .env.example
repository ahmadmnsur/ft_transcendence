# These are development defaults for a local, throwaway copy.
# Change the staff and seed passwords and the database password for any shared use.
# The OAuth pair ships empty and the platform works without it.
# Copy to .env to override locally.
POSTGRES_USER=peerconnect
POSTGRES_PASSWORD=peerconnect-dev-password
POSTGRES_DB=peerconnect
DATABASE_URL=postgresql://peerconnect:peerconnect-dev-password@db:5432/peerconnect
NODE_ENV=production
PUBLIC_ORIGIN=https://localhost:8443
HTTPS_PORT=8443
HTTP_PORT=8080
ADMIN_EMAIL=admin@peerconnect.test
ADMIN_PASSWORD=change-me-admin
FT_OAUTH_CLIENT_ID=
FT_OAUTH_CLIENT_SECRET=
MODERATOR_EMAIL=moderator@peerconnect.test
MODERATOR_PASSWORD=change-me-moderator
SEED_STUDENT_PASSWORD=change-me-student
