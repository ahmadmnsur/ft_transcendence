POSTGRES_PASSWORD=peerconnect-dev-password
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:peerconnect-dev-password@db:5432/postgres
NODE_ENV=production
PUBLIC_ORIGIN=https://localhost:8443
HTTPS_PORT=8443
HTTP_PORT=8080
BIND_ADDRESS=127.0.0.1
