server {
    listen 8081;

    include /etc/nginx/snippets/api.conf;

    location / {
        proxy_pass http://host.docker.internal:5173;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        error_page 502 = @vite_down;
    }

    location @vite_down {
        default_type text/plain;
        return 502 'Host Vite is not answering on $upstream_addr.
make dev does not start it. From the repository root run:
  npm --prefix web run dev -- --host <address> --port 5173 --strictPort
See README.md, Instructions, "Dev overlay and host Vite".
';
    }
}
